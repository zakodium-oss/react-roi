{
  "name": "react-roi",
  "version": "3.2.1",
  "files": [
    "lib-esm",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": "./lib-esm/index.js"
  },
  "scripts": {
    "build": "storybook build",
    "check-types": "tsc --noEmit",
    "clean": "rimraf lib-esm",
    "dev": "storybook dev -p 6006",
    "eslint": "eslint ./ --max-warnings=0",
    "eslint-fix": "npm run eslint -- --fix",
    "playwright": "npm run playwright-ct -- --project chromium",
    "playwright-ct": "playwright test -c playwright-ct.config.ts",
    "prepack": "npm run tsc",
    "prettier": "prettier --check ./",
    "prettier-write": "prettier --write ./",
    "test": "npm run playwright && npm run eslint && npm run prettier && npm run check-types",
    "test-only": "vitest",
    "tsc": "npm run clean && npm run tsc-esm",
    "tsc-esm": "tsc --project tsconfig.esm.json"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "dependencies": {
    "@react-hook/resize-observer": "^2.0.2",
    "immer": "^11.1.21"
  },
  "devDependencies": {
    "@playwright/experimental-ct-react": "~1.62.1",
    "@playwright/test": "~1.62.1",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@zakodium/tsconfig": "^1.0.5",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.12.0",
    "eslint-config-zakodium": "^21.0.0",
    "image-js": "^1.7.1",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-kbs": "^3.1.0",
    "rimraf": "^6.1.3",
    "storybook": "^10.6.2",
    "typescript": "~6.0.3",
    "uuid": "^14.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "volta": {
    "node": "26.12.0"
  }
}
